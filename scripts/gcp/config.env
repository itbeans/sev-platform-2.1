# ─────────────────────────────────────────────────────────────────────────────
# GCP Cloud Run deployment configuration
#
# Fill in every value marked REQUIRED before running the deployment scripts.
# Values already set to a default are safe to leave unless you need to change
# the naming scheme.
#
# Usage:
#   source scripts/gcp/config.env
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP Project ──────────────────────────────────────────────────────────────
# REQUIRED: your GCP project ID (not the project number)
GCP_PROJECT_ID="${GCP_PROJECT_ID:-your-gcp-project-id}"
GCP_REGION="${GCP_REGION:-europe-west1}"

# ── Artifact Registry ────────────────────────────────────────────────────────
AR_REPO="ev-platform"
IMAGE_PREFIX="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}"

# Git short SHA used as the image tag.  Override with IMAGE_TAG=vX.Y.Z if you
# want an explicit version tag.
_GIT_SHA=$(git -C "$(dirname "${BASH_SOURCE[0]}")/../.." rev-parse --short HEAD 2>/dev/null || echo "latest")
IMAGE_TAG="${IMAGE_TAG:-${_GIT_SHA}}"

# ── Service account ───────────────────────────────────────────────────────────
SA_NAME="ev-cloud-run"
SA_EMAIL="${SA_NAME}@${GCP_PROJECT_ID}.iam.gserviceaccount.com"

# ── Cloud SQL (PostgreSQL) ────────────────────────────────────────────────────
# Hosts ev_billing and ev_analytics databases.
# Note: TimescaleDB is not supported on Cloud SQL.  The analytics service will
# run on standard PostgreSQL; run the TimescaleDB extension on a GCE VM if
# time-series compression and continuous aggregates are required.
CLOUDSQL_INSTANCE="ev-postgres"
CLOUDSQL_TIER="${CLOUDSQL_TIER:-db-g1-small}"          # upgrade for production
CLOUDSQL_CONNECTION_NAME="${GCP_PROJECT_ID}:${GCP_REGION}:${CLOUDSQL_INSTANCE}"

BILLING_DB="ev_billing"
BILLING_USER="ev_billing"
ANALYTICS_DB="ev_analytics"
ANALYTICS_USER="ev_analytics"

# ── GCP Managed Service for Apache Kafka ─────────────────────────────────────
# Kafka cluster runs inside the VPC; Cloud Run reaches it via the VPC connector.
KAFKA_CLUSTER_ID="ev-kafka"
KAFKA_CLUSTER_SUBNET="${GCP_REGION}-kafka"     # /28 subnet created in 02-provision-infra.sh
KAFKA_REPLICATION_FACTOR=3
KAFKA_BOOTSTRAP="${KAFKA_CLUSTER_ID}.${GCP_REGION}.managedkafka.${GCP_PROJECT_ID}.cloud.goog:9092"

# Kafka topics created during provisioning
KAFKA_TOPICS=(
  "ocpp.messages"
  "notifications.outbound"
  "billing.events"
  "smart.charging.events"
  "asset.consumption"
  "analytics.audit"
)

# ── Serverless VPC connector ──────────────────────────────────────────────────
# Required so Cloud Run can reach the Kafka cluster's private VPC IP.
VPC_CONNECTOR_NAME="ev-vpc-connector"
VPC_NETWORK="default"
VPC_CONNECTOR_RANGE="10.8.0.0/28"    # must not overlap existing subnets

# ── Cloud Run service settings ────────────────────────────────────────────────
CR_REGION="${GCP_REGION}"

# Kafka consumers must keep at least one instance alive to avoid rebalances.
MIN_INSTANCES_CONSUMER=1
MIN_INSTANCES_HTTP=0

MAX_INSTANCES_GATEWAY=20    # OCPP WebSocket — may handle many concurrent stations
MAX_INSTANCES_DEFAULT=10

# ── MongoDB (external — Atlas or self-managed) ────────────────────────────────
# REQUIRED: set MONGO_URI in Secret Manager via 03-setup-secrets.sh; this
# variable is only used for documentation.
MONGO_DB_NAME="${MONGO_DB_NAME:-evserver}"

# ── External domain ───────────────────────────────────────────────────────────
# Public hostname used for OCPP/REST ingress and OCPI callback URLs.
EXTERNAL_DOMAIN="${EXTERNAL_DOMAIN:-csms.example.com}"
OCPI_COUNTRY_CODE="${OCPI_COUNTRY_CODE:-DE}"
OCPI_PARTY_ID="${OCPI_PARTY_ID:-EVX}"

# ── Secret Manager secret names ───────────────────────────────────────────────
# Referenced by 03-setup-secrets.sh and 05-deploy.sh.
SM_PREFIX="ev"
SM_MONGO_URI="${SM_PREFIX}/mongo-uri"
SM_JWT_SECRET="${SM_PREFIX}/jwt-secret"
SM_KAFKA_BOOTSTRAP="${SM_PREFIX}/kafka-bootstrap"
SM_KAFKA_SASL_CONFIG="${SM_PREFIX}/kafka-sasl-config"
SM_BILLING_JDBC_PASSWORD="${SM_PREFIX}/billing-jdbc-password"
SM_ANALYTICS_JDBC_PASSWORD="${SM_PREFIX}/analytics-jdbc-password"
SM_STRIPE_SECRET_KEY="${SM_PREFIX}/stripe-secret-key"
SM_STRIPE_WEBHOOK_SECRET="${SM_PREFIX}/stripe-webhook-secret"
SM_SMTP_PASSWORD="${SM_PREFIX}/smtp-password"
SM_FCM_SERVICE_ACCOUNT_JSON="${SM_PREFIX}/fcm-service-account-json"
SM_OCPI_LOCAL_TOKEN="${SM_PREFIX}/ocpi-local-token"
SM_SAP_OPTIMIZER_PASSWORD="${SM_PREFIX}/sap-optimizer-password"
